// phimint model configuration
// Supports JSON5: comments (// or /* */), trailing commas, single quotes

{
  // API configuration
  "base_url": "https://api.openai.com/v1",
  "api_key": "sk-xxx",
  "protocol": "openai",  // optional, auto-inferred from model name

  // Model tiers
  "main": "gpt-5.4-mini",
  "lite": "gpt-4o-mini",
  "advanced": "o1-preview",

  // Example: different provider for advanced
  // "advanced": {
  //   "model": "claude-opus-4",
  //   "base_url": "https://api.anthropic.com",
  //   "api_key": "sk-ant",
  //   "protocol": "anthropic"
  // },

  // Custom scene routing (optional)
  // "scene_tiers": {
  //   "main_chat": "main",
  //   "sub_agent": "lite",
  //   "architecture": "advanced",
  //   "review": "lite",
  //   "compression": "lite"
  // },

  // System update check (optional) — defaults to the official manifest endpoints
  // "update": {
  //   // Manifest URLs tried in order
  //   "endpoints": [
  //     "https://github.com/hibuka-labs/phimint/releases/latest/download/manifest.json",
  //     "https://gitee.com/chenkangzeng_admin/phimint/raw/release-metadata/manifest.json"
  //   ],
  //   "channel": "stable",
  //   "auto_check": true
  // },

  // Popup band layout (optional) — the `@`/`/` popup
  // "ui": {
  //   "popup": {
  //     "frame": true,
  //     "width": "fill",  // "fill" or a column count
  //     "height": 24,     // rows
  //     "separator": true
  //   }
  // }
}
