# phimint LLM configuration
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# genai auto-detects provider from model name. Set the API key
# for your chosen provider. See: https://docs.rs/genai

# ── Model ──

# Model name. genai detects the provider automatically:
#   OpenAI:      gpt-5.4-mini, gpt-4o, o3-mini
#   Anthropic:   claude-sonnet-4-5, claude-opus-4
#   DeepSeek:    deepseek-chat, deepseek-reasoner
#   Aliyun:      aliyun::qwen-plus, aliyun::qwen-max
#   Moonshot:    moonshot-v1-auto
#   Gemini:      gemini-2.0-flash
#   Ollama:      ollama::llama3 (local)
LLM_MODEL=gpt-5.4-mini

# ── API Keys (set the one matching your model) ──

# OpenAI / OpenAI-compatible
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Aliyun (DashScope)
# ALIYUN_API_KEY=sk-...

# Moonshot
# MOONSHOT_API_KEY=sk-...

# ── Session (optional) ──

# Custom session ID (auto-generated if not set)
# PHI_SESSION_ID=my-session
